# ---------------------------------------------------------------------------
#  THIS FILE BELONGS IN THE ENGINE REPO, not here.
#  Copy to  cubrid/.github/workflows/importdb-contract.yml
# ---------------------------------------------------------------------------
#
# cubrid-importdb is distributed as SOURCE and recompiled against the engine, so
# the contract is not an ABI -- it is "does it still compile, link and import".
# That makes the guard a build, and builds are what CI is good at.
#
# What can actually break the utility, and where it shows:
#
#   a header it includes is removed or renamed        -> compile
#   a function it calls is removed or renamed         -> compile
#   a signature changes with no compatible default    -> compile
#   a type it uses changes shape                      -> compile
#   utility.h's option/arg machinery changes          -> compile
#   util_support.c moves                              -> build
#   behaviour changes (authorization, SQL forms, the
#   cub_admin argv contract)                          -> only the smoke test
#
# So: compile on every PR (cheap), link + import nightly (needs a full build).
#
# Auth: the utility repo is private, so checking it out needs a token. This
# reuses the GitHub App pattern already in submodule-bump-receiver.yml -- install
# the same app on both repos and add IMPORTDB_CONTRACT_APP_{ID,PRIVATE_KEY}.

name: importdb-contract

on:
  pull_request:
    branches: [develop, 'release/11.**']
    paths:
      # the utility reaches into these; an unrelated PR should not pay for this
      - 'src/compat/**'
      - 'src/base/**'
      - 'src/object/**'
      - 'src/loaddb/**'
      - 'src/transaction/**'
      - 'src/executables/utility.h'
      - 'src/executables/util_support.c'
      - 'src/executables/util_func.h'
      - 'cubrid/CMakeLists.txt'
      - 'cs/CMakeLists.txt'
  schedule:
    - cron: '41 2 * * *'
  workflow_dispatch:

permissions:
  contents: read

env:
  UTILITY_REPO: cubrid-systems/cubrid-importdb
  UTILITY_REF: main

jobs:
  # --------------------------------------------------------- compile-only, ~2 min
  compile:
    name: importdb compiles against this tree
    runs-on: ubuntu-24.04
    steps:
      - name: checkout engine
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          submodules: recursive

      - name: build deps
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq cmake ninja-build ccache gcc g++ \
            libncurses-dev bison flex openjdk-17-jdk-headless

      # The utility's translation units need the engine's GENERATED and 3rdparty
      # headers, which live in a configured build tree. They change rarely, so
      # the tree is cached on the CMake inputs rather than rebuilt per PR.
      - name: cache the configured engine build tree
        id: cfgcache
        uses: actions/cache@1bd1e32a3bdc45362d1e726936510720a7c30a57 # v4
        with:
          path: build
          key: importdb-cfgtree-${{ hashFiles('CMakeLists.txt', '*/CMakeLists.txt', 'cmake/**', '3rdparty/**/CMakeLists.txt') }}

      - name: configure the engine (headers only; no engine compile)
        if: steps.cfgcache.outputs.cache-hit != 'true'
        run: |
          cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo
          # only the targets that produce generated + 3rdparty headers
          cmake --build build -j"$(nproc)" --target 3rdparty || true
          # a configure alone already writes the generated config headers

      - name: app token for the utility repo
        id: token
        uses: actions/create-github-app-token@d72941d797fd3113feb6b93fd0dec494b13a2547 # v1
        with:
          app-id: ${{ secrets.IMPORTDB_CONTRACT_APP_ID }}
          private-key: ${{ secrets.IMPORTDB_CONTRACT_APP_PRIVATE_KEY }}
          owner: ${{ github.repository_owner }}
          repositories: cubrid-importdb

      - name: checkout the utility repo
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          repository: ${{ env.UTILITY_REPO }}
          ref: ${{ env.UTILITY_REF }}
          token: ${{ steps.token.outputs.token }}
          path: .importdb

      - name: compile the utility against this engine tree
        run: |
          export CCACHE_DIR=~/.ccache
          export PATH=/usr/lib/ccache:$PATH
          cmake -S .importdb -B .importdb/build \
                -DBUILD_CONTRACT=OFF \
                -DCUBRID_SOURCE_DIR="$PWD" \
                -DCUBRID_BUILD_DIR="$PWD/build"
          # compile only -- linking needs libcubridcs, which is the nightly lane
          cmake --build .importdb/build -j"$(nproc)" --target cubrid-importdb 2>&1 | tee /tmp/build.log || true
          if grep -q "error:" /tmp/build.log; then
            echo "::error::the out-of-tree importdb no longer compiles against this tree"
            grep -m20 "error:" /tmp/build.log
            exit 1
          fi
          # a link failure here is expected (no library yet) and is not a verdict
          echo "compile clean"

      - name: what to do if this failed
        if: failure()
        run: |
          cat <<'EOM'
          cubrid-importdb is built from source against this engine, so a change
          here can stop it compiling. Three legitimate outcomes:

            1. unintended  -> keep the declaration / header / signature
            2. intended, and the utility must adapt -> land a PR there first,
               then this one
            3. the utility was depending on something it should not -> say so on
               its issue and let it change

          None of them is "ignore the red". The first compiler error above names
          exactly what moved.
          EOM

  # ------------------------------------------- link + actually import, nightly
  import:
    name: importdb links and imports
    runs-on: ubuntu-24.04
    if: github.event_name != 'pull_request'
    timeout-minutes: 180
    steps:
      - name: checkout engine
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          submodules: recursive

      - name: build deps
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq cmake ninja-build ccache gcc g++ \
            libncurses-dev bison flex openjdk-17-jdk-headless

      - name: ccache
        uses: actions/cache@1bd1e32a3bdc45362d1e726936510720a7c30a57 # v4
        with:
          path: ~/.ccache
          key: importdb-engine-ccache-${{ github.sha }}
          restore-keys: importdb-engine-ccache-

      - name: build + install the engine
        run: |
          export CCACHE_DIR=~/.ccache
          export PATH=/usr/lib/ccache:$PATH
          cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo \
                -DCMAKE_INSTALL_PREFIX="$PWD/install.out"
          cmake --build build -j"$(nproc)"
          cmake --install build
          ccache -s | head -5

      - name: app token for the utility repo
        id: token
        uses: actions/create-github-app-token@d72941d797fd3113feb6b93fd0dec494b13a2547 # v1
        with:
          app-id: ${{ secrets.IMPORTDB_CONTRACT_APP_ID }}
          private-key: ${{ secrets.IMPORTDB_CONTRACT_APP_PRIVATE_KEY }}
          owner: ${{ github.repository_owner }}
          repositories: cubrid-importdb

      - name: checkout the utility repo
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          repository: ${{ env.UTILITY_REPO }}
          ref: ${{ env.UTILITY_REF }}
          token: ${{ steps.token.outputs.token }}
          path: .importdb

      - name: build the utility (compile + link)
        run: |
          export CUBRID="$PWD/install.out"
          cmake -S .importdb -B .importdb/build \
                -DCUBRID_SOURCE_DIR="$PWD" \
                -DCUBRID_BUILD_DIR="$PWD/build"
          cmake --build .importdb/build -j"$(nproc)"

      - name: import something (the acceptance the compile cannot give)
        run: |
          export CUBRID="$PWD/install.out"
          useradd -m cub || true
          chown -R cub:cub "$CUBRID" .importdb
          su cub -c "CUBRID=$CUBRID bash .importdb/tools/smoke.sh $PWD/.importdb/build/cubrid-importdb"

      - name: behaviour contract against the fresh install
        run: |
          export CUBRID="$PWD/install.out"
          bash .importdb/contract/check_surface.sh --install "$CUBRID"
          su cub -c "CUBRID=$CUBRID CONTRACT_CHECK_BIN=$PWD/.importdb/build/contract_check \
                     bash .importdb/contract/run.sh"

      - name: negative control -- a non-DBA must FAIL the contract
        run: |
          export CUBRID="$PWD/install.out"
          if su cub -c "CUBRID=$CUBRID CONTRACT_CHECK_BIN=$PWD/.importdb/build/contract_check \
                        CONTRACT_NEGATIVE=1 bash .importdb/contract/run.sh"; then
            echo '::error::the negative control PASSED -- the suite is not discriminating'
            exit 1
          fi
          echo 'negative control failed the contract, as required'

      - name: logs on failure
        if: failure()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: importdb-contract-logs
          path: |
            install.out/log/**
            .importdb/build/CMakeFiles/*.log
          retention-days: 7
