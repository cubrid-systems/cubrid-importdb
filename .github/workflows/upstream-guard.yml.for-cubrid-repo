# ---------------------------------------------------------------------------
#  THIS FILE BELONGS IN THE ENGINE REPO, not here.
#  Copy to  cubrid/.github/workflows/importdb-contract.yml
# ---------------------------------------------------------------------------
#
# Purpose: an engine change must not silently break the out-of-tree importdb
# utility. The utility depends only on what CUBRID *installs* -- a small,
# enumerated surface (cubrid-importdb `contract/surface_manifest.txt`). Two
# lanes, because the two kinds of breakage cost very different amounts to find:
#
#   surface  (every PR, ~30 s, no build)  a header stops being installed, a
#            declaration disappears, a replicated constant changes, or one of
#            the source-shape contracts moves. This is most real breakage.
#
#   contract (nightly / on demand, needs a build) behaviour changes the static
#            lane cannot see: authorization tightened on a catalog class, an SQL
#            form withdrawn, the cub_admin argv contract changed, a symbol that
#            stopped being exported unmangled.
#
# Auth: the utility repo is private, so checking it out needs a token. This
# reuses the GitHub App pattern already in submodule-bump-receiver.yml -- install
# the same app on both repos and add IMPORTDB_CONTRACT_APP_{ID,PRIVATE_KEY}.
# (If the utility repo is made public, drop the token steps and check out plain.)

name: importdb-contract

on:
  pull_request:
    branches: [develop, 'release/11.**', 'feature/**']
    paths:
      # only the paths that can move the surface -- keeps this off unrelated PRs
      - 'cubrid/CMakeLists.txt'
      - 'cs/CMakeLists.txt'
      - 'src/compat/**'
      - 'src/base/error_code.h'
      - 'src/executables/util_admin.c'
      - 'src/executables/utility.h'
      - 'src/loaddb/**'
  schedule:
    - cron: '41 2 * * *'
  workflow_dispatch:
    inputs:
      full:
        description: 'also run the build-and-run contract lane'
        type: boolean
        default: true

permissions:
  contents: read

env:
  UTILITY_REPO: cubrid-systems/cubrid-importdb
  UTILITY_REF: main

jobs:
  # ------------------------------------------------------------------ cheap
  surface:
    name: importdb surface (static)
    runs-on: ubuntu-24.04
    steps:
      - name: checkout engine
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4

      - name: app token for the utility repo
        id: token
        uses: actions/create-github-app-token@d72941d797fd3113feb6b93fd0dec494b13a2547 # v1
        with:
          app-id: ${{ secrets.IMPORTDB_CONTRACT_APP_ID }}
          private-key: ${{ secrets.IMPORTDB_CONTRACT_APP_PRIVATE_KEY }}
          owner: ${{ github.repository_owner }}
          repositories: cubrid-importdb

      - name: checkout the utility repo (contract only)
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          repository: ${{ env.UTILITY_REPO }}
          ref: ${{ env.UTILITY_REF }}
          token: ${{ steps.token.outputs.token }}
          path: .importdb-contract
          sparse-checkout: contract
          sparse-checkout-cone-mode: false

      - name: check the surface against this engine tree
        run: bash .importdb-contract/contract/check_surface.sh --source "$PWD"

      - name: what to do if this failed
        if: failure()
        run: |
          cat <<'EOM'
          The out-of-tree importdb utility depends on the surface listed in
          cubrid-importdb contract/surface_manifest.txt, and this change moved it.

          Three legitimate outcomes:
            1. the move was unintended  -> keep installing / declaring it
            2. the move is intended and the utility must adapt -> open a PR there
               first, then land this with the manifest updated
            3. the requirement was wrong -> drop the line from the manifest

          None of them is "ignore the red". The failing line names exactly what
          moved.
          EOM

  # ------------------------------------------------------------------- heavy
  contract:
    name: importdb contract (build + run)
    runs-on: ubuntu-24.04
    if: github.event_name == 'schedule' || inputs.full
    timeout-minutes: 180
    steps:
      - name: checkout engine
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          submodules: recursive

      - name: build deps
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq cmake ninja-build ccache gcc g++ \
            libncurses-dev bison flex openjdk-17-jdk-headless

      - name: ccache
        uses: actions/cache@1bd1e32a3bdc45362d1e726936510720a7c30a57 # v4
        with:
          path: ~/.ccache
          key: importdb-contract-ccache-${{ github.sha }}
          restore-keys: importdb-contract-ccache-

      - name: build + install the engine
        run: |
          export CCACHE_DIR=~/.ccache
          export PATH=/usr/lib/ccache:$PATH
          # Only what the contract needs: the CS client library, the utility
          # drivers, and the install rules that place the headers.
          cmake -S . -B build -G Ninja \
                -DCMAKE_BUILD_TYPE=RelWithDebInfo \
                -DCMAKE_INSTALL_PREFIX="$PWD/install.out"
          cmake --build build -j"$(nproc)"
          cmake --install build
          ccache -s | head -5

      - name: app token for the utility repo
        id: token
        uses: actions/create-github-app-token@d72941d797fd3113feb6b93fd0dec494b13a2547 # v1
        with:
          app-id: ${{ secrets.IMPORTDB_CONTRACT_APP_ID }}
          private-key: ${{ secrets.IMPORTDB_CONTRACT_APP_PRIVATE_KEY }}
          owner: ${{ github.repository_owner }}
          repositories: cubrid-importdb

      - name: checkout the utility repo
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          repository: ${{ env.UTILITY_REPO }}
          ref: ${{ env.UTILITY_REF }}
          token: ${{ steps.token.outputs.token }}
          path: .importdb-contract

      - name: static surface check against the fresh install
        run: |
          export CUBRID="$PWD/install.out"
          bash .importdb-contract/contract/check_surface.sh --install "$CUBRID"

      - name: build the utility's contract check against the fresh install
        run: |
          export CUBRID="$PWD/install.out"
          cmake -S .importdb-contract -B .importdb-contract/build \
                -DCMAKE_BUILD_TYPE=RelWithDebInfo \
                -DCMAKE_CXX_FLAGS="-Wall -Wextra -Werror"
          cmake --build .importdb-contract/build -j"$(nproc)"

      - name: run the contract
        run: |
          export CUBRID="$PWD/install.out"
          export CONTRACT_CHECK_BIN="$PWD/.importdb-contract/build/contract_check"
          bash .importdb-contract/contract/run.sh

      - name: negative control -- a non-DBA must FAIL the contract
        run: |
          export CUBRID="$PWD/install.out"
          export CONTRACT_CHECK_BIN="$PWD/.importdb-contract/build/contract_check"
          if CONTRACT_NEGATIVE=1 bash .importdb-contract/contract/run.sh; then
            echo 'the negative control PASSED -- the suite is not discriminating'
            exit 1
          fi
          echo 'negative control failed the contract, as required'

      - name: keep the install for triage
        if: failure()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: contract-failure-logs
          path: |
            install.out/log/**
            .importdb-contract/build/CMakeFiles/*.log
          retention-days: 7
